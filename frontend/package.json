{
  "name": "frontend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "dev:clean": "node -e \"const fs=require('fs'); for (const p of ['.next/cache','.next/dev/cache']) fs.rmSync(p,{recursive:true,force:true});\" && next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
