DATABASE_URL=postgres://postgres:admin@localhost:5432/real_state
# DATABASE_INTERNAL_URL=postgres://posgress:posgress@test_project_posgress:5432/posgress?sslmode=disable
JWT_SECRET=your-super-secret-key-min-32-chars!!
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-at-least-12-characters
DEFAULT_ADMIN_FIRST_NAME=System
DEFAULT_ADMIN_LAST_NAME=Admin
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin12345
MINIO_BUCKET_NAME=eliteestates
MINIO_USE_SSL=false
PORT=4000
NODE_ENV=development
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# Gmail one-click OAuth
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/settings/integrations/gmail/callback
GOOGLE_TENANT_GMAIL_REDIRECT_URI=http://localhost:4000/api/tenant-workspace-public/integrations/gmail/callback

# Tenant database connection-pool settings
# Two lazy connections per active tenant keeps 30 subdomains bounded while
# allowing independent request and worker traffic. Increase only after measuring.
# Stable secret used to derive a different PostgreSQL password for every tenant DB role.
TENANT_DB_ROLE_SECRET=replace-with-a-long-random-stable-tenant-db-role-secret
TENANT_DB_POOL_MAX=2
TENANT_DB_IDLE_TIMEOUT_MS=60000
TENANT_DB_CONNECTION_TIMEOUT_MS=5000
TENANT_DB_POOL_CACHE_MAX=64
TENANT_DB_POOL_CACHE_IDLE_MS=900000
TENANT_DB_HEALTH_TTL_MS=30000
TENANT_DB_AUTO_MIGRATE=true
TENANT_DB_MIGRATION_CONCURRENCY=4

# Tenant-isolated durable outreach worker
TENANT_OUTREACH_WORKER_ENABLED=true
TENANT_WORKER_TENANT_CONCURRENCY=4
TENANT_WORKER_DELIVERY_CONCURRENCY=3
TENANT_OUTREACH_BATCH_SIZE=25
TENANT_OUTREACH_MAX_ATTEMPTS=5
TENANT_OUTREACH_STALE_MINUTES=15
TENANT_OUTREACH_RETRY_BASE_SECONDS=60
TENANT_OUTREACH_RETRY_MAX_SECONDS=21600

# Tenant-isolated mailbox synchronization
TENANT_INBOX_SYNC_ENABLED=true
TENANT_INBOX_TENANT_CONCURRENCY=3
TENANT_INBOX_STALE_MINUTES=20
TENANT_INBOX_MAX_RETRIES=8

# Tenant-isolated SMS synchronization
TENANT_SMS_SYNC_ENABLED=true
TENANT_SMS_TENANT_CONCURRENCY=3
TENANT_SMS_STALE_MINUTES=20
TENANT_SMS_MAX_RETRIES=8

# Security and reliability settings
API_BODY_LIMIT=1mb
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
# Use a stable secret so Stripe credentials saved by Super Admin remain decryptable.
PLATFORM_SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-stable-secret
# Production JWT_SECRET must be at least 32 characters.
JWT_SECRET=replace-with-a-long-random-production-secret

# Optional Stripe fallbacks. Super Admin can override these in /super-admin/settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=usd

# Tenant knowledge chatbot: Qdrant vector database + local MiniLM cache
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=real_estate_knowledge
CHATBOT_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-xs
CHATBOT_EMBEDDING_DTYPE=q8
CHATBOT_MODEL_PATH=.cache/chatbot-models
# Keep true to auto-download missing model files on backend startup; cached files are reused.
CHATBOT_ALLOW_REMOTE_MODELS=true
# Global emergency worker kill switch only. Each tenant independently controls
# its master chatbot switch, Web/Email/SMS channels, confidence, delay and stop rules.
TENANT_CHATBOT_WORKER_ENABLED=true
